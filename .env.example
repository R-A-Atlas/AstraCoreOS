# AstraCore OS environment template
#
# Copy this file to `.env` for local development.
# Never commit `.env`. It contains private credentials.

# ---------------------------------------------------------------------------
# Runtime / cost controls
# ---------------------------------------------------------------------------

ASTRA_ENV=local
ASTRA_MODEL_PROVIDER=local
ENABLE_PAID_MODELS=false
ASTRA_MAX_PAID_CALLS_PER_DAY=0
ASTRA_REQUIRE_CONFIRMATION_FOR_PAID_MODELS=true

# Local workspace paths
ASTRA_WORKSPACE_DIR=workspace
ASTRA_MEMORY_MODE=local

# ---------------------------------------------------------------------------
# Gemini / Google AI Studio
# ---------------------------------------------------------------------------
# Use for the first real natural-language brain.
# Get it from:
# https://aistudio.google.com/app/apikey
#
# Keep ENABLE_PAID_MODELS=false until we wire and test the safety controls.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# OpenAI, optional later
# ---------------------------------------------------------------------------
# Use as a higher-quality fallback later if needed.
# Get it from:
# https://platform.openai.com/api-keys

OPENAI_API_KEY=
OPENAI_MODEL=

# ---------------------------------------------------------------------------
# Anthropic Claude, optional later
# ---------------------------------------------------------------------------
# Use only if you intentionally want Claude API calls.
# Get it from:
# https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ---------------------------------------------------------------------------
# DeepSeek, optional cheaper model route later
# ---------------------------------------------------------------------------
# Get it from:
# https://platform.deepseek.com/api_keys

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# ---------------------------------------------------------------------------
# OpenRouter / Hermes / other hosted model routes, optional later
# ---------------------------------------------------------------------------
# Use if we want to route to Hermes, DeepSeek, or other low-cost models through
# one OpenAI-compatible endpoint.
# Get it from:
# https://openrouter.ai/settings/keys

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Use for accounts, persisted memory, sessions, user profiles, and later auth.
# Create project:
# https://supabase.com/dashboard/projects
#
# Then find values in:
# Supabase project -> Settings -> API / API Keys
#
# IMPORTANT:
# - SUPABASE_ANON_KEY can be used by the frontend only after RLS is correct.
# - SUPABASE_SERVICE_ROLE_KEY is backend-only. Never expose it in browser code.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Google OAuth, optional later
# ---------------------------------------------------------------------------
# Use for "Sign in with Google" after Supabase auth is wired.
# Create credentials in:
# https://console.cloud.google.com/apis/credentials

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# GitHub
# ---------------------------------------------------------------------------
# Usually no key is needed for local Git if Git Credential Manager is signed in.
# Repo for this project:
# https://github.com/R-A-Atlas/AstraCoreOS
#
# Optional only for GitHub API automation later:
# https://github.com/settings/tokens

GITHUB_REPOSITORY=R-A-Atlas/AstraCoreOS
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Email, optional later
# ---------------------------------------------------------------------------
# Do not enable email sending until permissions, rate limits, audit logs, and
# unsubscribe/compliance rules are implemented.

EMAIL_PROVIDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
SENDGRID_API_KEY=

