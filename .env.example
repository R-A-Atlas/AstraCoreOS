# ---------------------------------------------------------------------------
# AstraCore OS Project
# ---------------------------------------------------------------------------

PROJECT_NAME=AstraCoreOS
APP_NAME=AstraCore
ENVIRONMENT=development
APP_URL=http://127.0.0.1:8010

# ---------------------------------------------------------------------------
# Runtime / Cost Controls
# ---------------------------------------------------------------------------
# Keep paid models off until the model router is wired and tested.

ASTRA_ENV=local
ASTRA_MODEL_PROVIDER=local
ENABLE_PAID_MODELS=false
ASTRA_MAX_PAID_CALLS_PER_DAY=0
ASTRA_REQUIRE_CONFIRMATION_FOR_PAID_MODELS=true
ASTRA_WORKSPACE_DIR=workspace
ASTRA_MEMORY_MODE=local

# Tier routing defaults:
# Tier 0 = casual chat
# Tier 1 = normal work
# Tier 2 = research
# Tier 3 = deep research

ASTRA_TIER0_PROVIDER=local
ASTRA_TIER1_PROVIDER=gemini
ASTRA_TIER2_PROVIDER=gemini
ASTRA_TIER3_PROVIDER=openai

# ---------------------------------------------------------------------------
# Gemini / Google AI Studio
# ---------------------------------------------------------------------------
# Get key from:
# https://aistudio.google.com/app/apikey
#
# Recommended usage:
# - Flash-Lite: cheapest/fastest lightweight replies
# - Flash: default normal assistant + packet synthesis
# - Pro: deep reasoning / hard tasks later
#
# Official docs list Gemini 2.5 Flash as price-performance for low-latency,
# high-volume reasoning tasks, Flash-Lite as fastest/budget, and Pro as the
# advanced complex-task model.

GEMINI_API_KEY=

# Text / reasoning models:
# - gemini-2.5-flash-lite
# - gemini-2.5-flash
# - gemini-2.5-pro
#
# Realtime voice / audio models:
# - gemini-2.5-flash-live-preview
# - gemini-2.5-flash-tts-preview
# - gemini-2.5-pro-tts-preview
#
# Generative media models, not wired yet:
# - nano-banana
# - nano-banana-pro-preview
# - nano-banana-2-preview
# - veo-3.1-preview

GEMINI_AVAILABLE_TEXT_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-2.5-pro
GEMINI_AVAILABLE_AUDIO_MODELS=gemini-2.5-flash-live-preview,gemini-2.5-flash-tts-preview,gemini-2.5-pro-tts-preview
GEMINI_AVAILABLE_MEDIA_MODELS=nano-banana,nano-banana-pro-preview,nano-banana-2-preview,veo-3.1-preview
GEMINI_MODEL_FAST=gemini-2.5-flash-lite
GEMINI_MODEL_DEFAULT=gemini-2.5-flash
GEMINI_MODEL_REASONING=gemini-2.5-pro
GEMINI_MODEL_DEEP_RESEARCH=gemini-2.5-pro
GEMINI_MODEL_VOICE=gemini-2.5-flash-live-preview
GEMINI_MODEL_TTS=gemini-2.5-flash-tts-preview
GEMINI_MODEL_IMAGE=nano-banana
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------
# Get key from:
# https://platform.openai.com/api-keys
#
# Recommended usage:
# - gpt-5.4-mini: lower-cost normal/research fallback
# - gpt-5.4: stronger professional reasoning
# - gpt-5.5: expensive flagship, reserve for Tier 3 or review

OPENAI_API_KEY=

# Text / reasoning models:
# - gpt-5.5
# - gpt-5.4
# - gpt-5.4-mini
# - gpt-5.4-nano
# - gpt-5.3-codex
#
# Specialized OpenAI features to wire later:
# - Web search
# - File search
# - Computer use
# - Realtime voice
# - Image generation
# - Embeddings
# - Moderation

OPENAI_AVAILABLE_TEXT_MODELS=gpt-5.5,gpt-5.4,gpt-5.4-mini,gpt-5.4-nano,gpt-5.3-codex
OPENAI_MODEL_FAST=gpt-5.4-mini
OPENAI_MODEL_DEFAULT=gpt-5.4
OPENAI_MODEL_REASONING=gpt-5.5
OPENAI_MODEL_DEEP_RESEARCH=gpt-5.5
OPENAI_MODEL_CODING=gpt-5.3-codex
OPENAI_MODEL_LOW_COST=gpt-5.4-nano
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=medium
OPENAI_REASONING_EFFORT_FAST=low
OPENAI_REASONING_EFFORT_DEFAULT=medium
OPENAI_REASONING_EFFORT_DEEP=high

# ---------------------------------------------------------------------------
# Anthropic Claude, optional later
# ---------------------------------------------------------------------------
# Get key from:
# https://console.anthropic.com/settings/keys
#
# Recommended usage:
# - Haiku: fastest Claude route
# - Sonnet: balanced coding/reasoning
# - Opus: most capable, reserve for difficult reviews

ANTHROPIC_API_KEY=

# Claude models:
# - claude-haiku-4-5
# - claude-sonnet-4-6
# - claude-opus-4-7

ANTHROPIC_AVAILABLE_TEXT_MODELS=claude-haiku-4-5,claude-sonnet-4-6,claude-opus-4-7
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6
ANTHROPIC_MODEL_REASONING=claude-opus-4-7
ANTHROPIC_MODEL_DEEP_RESEARCH=claude-opus-4-7
ANTHROPIC_MODEL_CODING=claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# DeepSeek, optional cheaper route later
# ---------------------------------------------------------------------------
# Get key from:
# https://platform.deepseek.com/api_keys
#
# Current preferred names:
# - deepseek-v4-flash: cheaper general model route
# - deepseek-v4-pro: stronger route
#
# Compatibility aliases deepseek-chat and deepseek-reasoner exist but official
# docs say they will be deprecated in the future.

DEEPSEEK_API_KEY=

# DeepSeek models:
# - deepseek-v4-flash
# - deepseek-v4-pro
# - deepseek-chat       compatibility alias, avoid for new code
# - deepseek-reasoner   compatibility alias, avoid for new code

DEEPSEEK_AVAILABLE_TEXT_MODELS=deepseek-v4-flash,deepseek-v4-pro,deepseek-chat,deepseek-reasoner
DEEPSEEK_MODEL_FAST=deepseek-v4-flash
DEEPSEEK_MODEL_DEFAULT=deepseek-v4-flash
DEEPSEEK_MODEL_REASONING=deepseek-v4-pro
DEEPSEEK_MODEL_DEEP_RESEARCH=deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-flash

# ---------------------------------------------------------------------------
# OpenRouter / Hermes / multi-model router, optional later
# ---------------------------------------------------------------------------
# Get key from:
# https://openrouter.ai/settings/keys
#
# openrouter/auto can choose a route automatically, but for production we
# should pin exact model IDs after testing cost/quality.

OPENROUTER_API_KEY=

# OpenRouter can access many hosted models. Start with openrouter/auto, then
# pin exact IDs after testing. Provider model IDs change often, so treat these
# as defaults and verify in OpenRouter before production.

OPENROUTER_AVAILABLE_ROUTING_MODELS=openrouter/auto
OPENROUTER_MODEL_FAST=openrouter/auto
OPENROUTER_MODEL_DEFAULT=openrouter/auto
OPENROUTER_MODEL_REASONING=openrouter/auto
OPENROUTER_MODEL_DEEP_RESEARCH=openrouter/auto
OPENROUTER_MODEL_HERMES=openrouter/auto
OPENROUTER_MODEL=openrouter/auto

# ---------------------------------------------------------------------------
# Local / self-hosted models, optional later
# ---------------------------------------------------------------------------
# Use this when we add Ollama, LM Studio, vLLM, or another local server.
# No API key needed for a local-only endpoint.

LOCAL_MODEL_PROVIDER=none
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434
LOCAL_MODEL_FAST=
LOCAL_MODEL_DEFAULT=
LOCAL_MODEL_REASONING=
LOCAL_MODEL_EMBEDDINGS=

# ---------------------------------------------------------------------------
# Embeddings / vector memory, optional later
# ---------------------------------------------------------------------------
# These are for searchable memory and document retrieval. Leave blank until
# memory moves beyond JSONL/local files.

EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=
VECTOR_STORE_PROVIDER=local
VECTOR_STORE_URL=
VECTOR_STORE_API_KEY=

# ---------------------------------------------------------------------------
# Supabase for AstraCore
# ---------------------------------------------------------------------------
# Create project:
# https://supabase.com/dashboard/projects
#
# Find values in:
# Supabase project -> Settings -> API / API Keys
#
# Important:
# - SUPABASE_ANON_KEY can be used by frontend only after RLS is correct.
# - SUPABASE_SERVICE_ROLE_KEY is backend-only. Never expose it in browser code.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Google OAuth for AstraCore, optional later
# ---------------------------------------------------------------------------
# Use later for "Sign in with Google".
# Create credentials:
# https://console.cloud.google.com/apis/credentials

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# GitHub for AstraCore
# ---------------------------------------------------------------------------
# Local Git push already works without a token on this machine.
# Use GITHUB_TOKEN only for GitHub API automation later.
#
# Repo:
# https://github.com/R-A-Atlas/AstraCoreOS

GITHUB_REPOSITORY=R-A-Atlas/AstraCoreOS
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Email, optional later
# ---------------------------------------------------------------------------
# Do not enable sending until permissions, rate limits, audit logs, and
# unsubscribe/compliance controls are implemented.

EMAIL_PROVIDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
SENDGRID_API_KEY=
